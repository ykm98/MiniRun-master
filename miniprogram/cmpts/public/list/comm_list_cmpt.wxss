/*sort - iOS 毛玻璃风格*/
.tabs {
	display: flex;
	align-items: center;
	justify-content: flex-start;
	font-size: 28rpx;
	color: #86868B;
	height: 88rpx;
	line-height: 88rpx;
	background: transparent !important;
}

.tabs .tab {
	flex-grow: 1;
	text-align: center;
	position: relative;
	margin-right: 10rpx;
	font-size: 28rpx;
	color: #86868B;
}

.tabs .cur,
.tabs .tab-menu.cur,
.tabs .tab.text-orange.cur {
	color: #007AFF !important;
}

.tabs .tab-menu.cur:after {
	content: " ";
	position: absolute;
	left: 50%;
	bottom: 8rpx;
	width: 32rpx;
	height: 6rpx;
	border-radius: 999rpx;
	background-color: #007AFF;
	transform: translateX(-50%);
}

.tabs .icon {
	color: #1D1D1F;
}

.sort {
	position: absolute;
	top: 178rpx;
	bottom: 0;
	width: 100%;
	background-color: rgba(0, 0, 0, 0.25);
	backdrop-filter: blur(10rpx);
	-webkit-backdrop-filter: blur(10rpx);
	z-index: 999;
	left: 0;
}

.sort .sort-item {
	border-top: 1rpx solid rgba(0, 0, 0, 0.06);
	height: 88rpx;
	line-height: 88rpx;
	padding-left: 50rpx;
	background: rgba(255, 255, 255, 0.92);
	backdrop-filter: blur(40rpx);
	-webkit-backdrop-filter: blur(40rpx);
}

/**头部 - 毛玻璃搜索栏*/
.top_bar {
	width: 100%;
	background: rgba(255, 255, 255, 0.72) !important;
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.top_bar .bar.search {
	background: transparent !important;
	padding: 12rpx 24rpx !important;
}

.top_bar .search-form {
	background: rgba(118, 118, 128, 0.12) !important;
	border: none !important;
	border-radius: 20rpx !important;
	height: 72rpx !important;
}

.top_bar .search-form input {
	font-size: 28rpx;
	color: #1D1D1F;
}

.top_bar_scroll {
	position: fixed;
	top: 0rpx;
	left: 0;
	z-index: 99;
	background: rgba(255, 255, 255, 0.85);
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	z-index: 999;
}

.box-list {
	display: flex;
	flex-direction: column;
	height: 100vh;
	overflow: hidden;
	background: transparent;
}

.box-list-scroll {
	flex: 1;
	height: 1px;
}

.top-button {
	position: fixed;
	bottom: 50rpx;
	right: 30rpx;
	opacity: .8;
}

.list-scroll-view {
	display: inline-block;
	padding: 0 16rpx;
	font-size: 28rpx;
}

.pulldown-mask {
	width: 100%;
	height: 100%;
	position: fixed;
	background-color: rgba(0, 0, 0, 0.3);
	top: 0;
	left: 0;
	backdrop-filter: blur(4rpx);
	-webkit-backdrop-filter: blur(4rpx);
}

.pulldown-scroll-view {
	height: 840rpx;
	width: 100%;
}

.pulldown-btn {
	font-size: 28rpx;
	color: #1D1D1F !important;
	height: 100rpx;
	width: 200rpx;
	line-height: 1.3;
	padding: 0 15rpx;
}

/* date */
.search-date {
	width: 100%;
	display: flex;
	align-items: center;
	padding: 0 20rpx;
}

.search-date .date-title {
	font-size: 28rpx;
	margin-right: 8rpx;
}

.search-date .date-group {
	color: #86868B;
	border: 1rpx solid rgba(0, 0, 0, 0.08);
	border-radius: 20rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 8rpx 20rpx;
	font-size: 29rpx;
	background: rgba(118, 118, 128, 0.08);
}

.search-date .text-line1 {
	color: #86868B;
	margin: 0 18rpx;
}

.search-date .text-line2 {
	color: #1D1D1F;
}

.search-date .search-date-picker {
	width: 150rpx;
}
