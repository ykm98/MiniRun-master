@import '../../../../../../style/public/admin.wxss';

.main-admin {
	width: 100%;
	min-height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	position: relative;
	background: transparent;
}

.login {
	width: 600rpx;
	background: rgba(255, 255, 255, 0.78);
	backdrop-filter: blur(50rpx) saturate(200%);
	-webkit-backdrop-filter: blur(50rpx) saturate(200%);
	border: 1rpx solid rgba(255, 255, 255, 0.9);
	min-height: 550rpx;
	border-radius: 32rpx;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: center;
	padding: 50rpx 20rpx;
	margin-top: -100rpx;
	box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.1);
}

.login button {
	width: 85%;
	color: #fff;
	font-size: 32rpx;
	border-radius: 999rpx;
	background: linear-gradient(180deg, #3395FF 0%, #007AFF 100%) !important;
	font-weight: 600;
}

.login .hint {
	width: 100%;
	color: #1D1D1F;
	font-weight: 600;
	font-size: 36rpx;
	text-align: center;
}

.login .return {
	width: 100%;
	font-size: 26rpx;
	text-align: center;
	color: #007AFF;
}

.pic {
	width: 180rpx;
	height: 180rpx;
	font-size: 130rpx;
	display: flex;
	justify-content: center;
	align-items: center;
}

.foot-bottom {
	width: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
	position: absolute;
	bottom: 50rpx;
}

.site-footer {
	color: #86868B !important;
}

.form-group .title {
	color: #1D1D1F;
}

.form-group-pwd {
	width: 100%;
	padding: 25rpx 30rpx;
	color: #86868B !important;
}
