@import '../../../../../../style/public/admin.wxss';

.main-admin {
	padding: 0;
	background: transparent;
}

.admin-info {
	height: 200rpx;
	width: 100%;
	color: #fff;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	position: relative;
	background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%) !important;
	border-radius: 0 0 32rpx 32rpx;
}

.admin-info .pic {
	width: 100rpx;
	height: 100rpx;
	font-size: 70rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	margin-right: 20rpx;
	border-radius: 24rpx;
	margin-left: 20rpx;
	background: rgba(255, 255, 255, 0.2);
}

.admin-info .right {
	flex: 1;
	display: flex;
	flex-direction: column;
}

.admin-info .right .name {
	font-size: 32rpx;
	line-height: 1.8;
	font-weight: 600;
}

.admin-info .right .desc {
	font-size: 24rpx;
	line-height: 1.3;
	opacity: 0.85;
}

.admin-info .exit-admin {
	position: absolute;
	top: 12rpx;
	right: 12rpx;
	font-size: 45rpx;
}

.main-admin .comm-list,
.main-admin .bar {
	background: rgba(255, 255, 255, 0.72) !important;
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	width: 100%;
	border-radius: 28rpx;
	margin: 16rpx 0;
}

.main-admin .exit {
	width: 100%;
	padding: 0 20rpx;
	margin-bottom: 50rpx;
}

.main-admin .exit button {
	width: 100%;
	color: #fff;
	height: 88rpx;
	border-radius: 999rpx;
	background: linear-gradient(180deg, #3395FF 0%, #007AFF 100%) !important;
	font-weight: 600;
}

.grid.col-6>view {
	width: 16.66%;
}

.foot-bottom {
	width: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
	bottom: 50rpx;
}
