/**
 * 任务详情页共享样式
 */
@import "/projects/crun/style/skin.wxss";

page {
	background: linear-gradient(165deg, #DCE6F0 0%, #EEF2F7 35%, #E4EAF2 70%, #D8E2EC 100%);
}

.article {
	width: 100%;
	background: rgba(255, 255, 255, 0.72);
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	border: 1rpx solid rgba(255, 255, 255, 0.85);
	box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
	padding: 36rpx 28rpx;
	border-radius: 32rpx;
	display: flex;
	flex-direction: column;
	justify-content: center;
	position: relative;
	overflow: hidden;
}

.article .mark-status {
	position: absolute;
	top: 20rpx;
	right: 20rpx;
	font-size: 24rpx;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
	font-weight: 500;
}

.article .mark-status.bg-orange.light {
	background: rgba(255, 149, 0, 0.15) !important;
	color: #FF9500 !important;
}

.article .mark-status.bg-blue.light {
	background: rgba(0, 122, 255, 0.15) !important;
	color: #007AFF !important;
}

.article .mark-status.bg-green.light {
	background: rgba(52, 199, 89, 0.15) !important;
	color: #34C759 !important;
}

.article .mark-status.bg-grey.light {
	background: rgba(142, 142, 147, 0.15) !important;
	color: #8E8E93 !important;
}

.article>.title {
	font-size: 36rpx;
	line-height: 1.5;
	color: #1D1D1F;
	font-weight: 600;
	z-index: 999;
	margin-top: 42rpx;
}

.article .time {
	font-size: 24rpx;
	line-height: 1.5;
	color: #86868B;
	margin-top: 20rpx;
}

.article .time>text {
	margin-right: 10rpx;
}

.article .list {
	width: 100%;
	display: flex;
	flex-direction: column;
	padding: 20rpx 0;
}

.article .list .item {
	width: 100%;
	display: flex;
	align-items: baseline;
	padding: 16rpx 0;
	border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.article .list .item:last-child {
	border-bottom: 0;
}

.article .list .item .left {
	font-size: 26rpx;
	color: #86868B;
	width: 160rpx;
	display: flex;
}

.article .list .item .right {
	flex: 1;
	font-size: 26rpx;
	color: #1D1D1F;
}

.article .list .item .right.pics {
	margin-top: 30rpx;
	display: flex;
	flex-wrap: wrap;
}

.article .list .item .right.pics image {
	width: 140rpx;
	height: 140rpx;
	border-radius: 16rpx;
	margin-bottom: 10rpx;
	margin-right: 15rpx;
}

.accept-line {
	width: 100%;
	margin-top: 20rpx;
	font-size: 24rpx;
	color: #86868B;
	padding: 20rpx;
	text-align: center;
}

.bottom-line {
	height: 140rpx;
	background: rgba(255, 255, 255, 0.85);
	backdrop-filter: blur(40rpx);
	-webkit-backdrop-filter: blur(40rpx);
	border: 1rpx solid rgba(255, 255, 255, 0.9);
	border-radius: 999rpx;
	display: flex;
	align-content: space-between;
	align-items: center;
	padding: 0 20rpx;
	position: relative;
	box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.bottom-line .oprt {
	background: linear-gradient(180deg, #3395FF 0%, #007AFF 100%);
	color: #FFFFFF;
	padding: 20rpx 40rpx;
	border-radius: 999rpx;
	font-weight: 600;
	box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.35);
}

.bottom-line .oprt.bg-grey.light,
.bottom-line .oprt.bg-green.light {
	background: rgba(142, 142, 147, 0.15) !important;
	color: #8E8E93 !important;
	box-shadow: none;
}

.cmpt-biz-detail-mode2 .inner .slot-inner {
	flex: 1;
	display: flex;
	justify-content: flex-end;
}

.cmpt-biz-detail-mode2 .inner {
	padding: 0 !important;
}

.time-box {
	font-size: 26rpx;
	color: #FF9500;
	border-radius: 28rpx;
	padding: 40rpx 20rpx;
	background: rgba(255, 255, 255, 0.72);
	backdrop-filter: blur(40rpx);
	-webkit-backdrop-filter: blur(40rpx);
	border: 1rpx solid rgba(255, 255, 255, 0.85);
	box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
	margin: 20rpx;
}

.time-item {
	border-radius: 12rpx;
	font-size: 26rpx;
	text-align: center;
	margin: 0 12rpx;
	padding: 10rpx 10rpx;
	background: linear-gradient(135deg, rgba(255, 149, 0, 0.2), rgba(255, 204, 0, 0.2));
	color: #1D1D1F;
	font-weight: 600;
}

.time-item1 {
	width: 30rpx;
	height: 40rpx;
	background: linear-gradient(135deg, rgba(255, 149, 0, 0.2), rgba(255, 204, 0, 0.2));
	margin: 0 10rpx;
	border-radius: 8rpx;
	font-size: 24rpx;
	text-align: center;
	line-height: 40rpx;
	color: #1D1D1F;
}
