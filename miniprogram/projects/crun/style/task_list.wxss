/**
 * 任务列表页共享样式（快递/代买/急事/陪替）
 */
@import "/projects/crun/style/skin.wxss";

page {
	background: linear-gradient(165deg, #DCE6F0 0%, #EEF2F7 35%, #E4EAF2 70%, #D8E2EC 100%);
}

.main {
	padding: 0;
}

.list {
	width: 100%;
	box-sizing: border-box;
	padding: 16rpx 24rpx 160rpx 24rpx;
	display: flex;
	flex-direction: column;
	justify-content: center;
	overflow: hidden;
}

.list .item {
	padding: 28rpx 28rpx 48rpx;
	display: flex;
	border-radius: 32rpx;
	margin-bottom: 24rpx;
	position: relative;
	background: rgba(255, 255, 255, 0.72);
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	border: 1rpx solid rgba(255, 255, 255, 0.85);
	box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
	overflow: hidden;
	flex-direction: column;
}

.list .item .mark-status {
	position: absolute;
	top: 20rpx;
	right: 20rpx;
	font-size: 22rpx;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 9;
	font-weight: 500;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.list .item .mark-status.bg-orange.light {
	background: rgba(255, 149, 0, 0.15) !important;
	color: #FF9500 !important;
}

.list .item .mark-status.bg-blue.light {
	background: rgba(0, 122, 255, 0.15) !important;
	color: #007AFF !important;
}

.list .item .mark-status.bg-green.light {
	background: rgba(52, 199, 89, 0.15) !important;
	color: #34C759 !important;
}

.list .item .mark-status.bg-grey.light {
	background: rgba(142, 142, 147, 0.15) !important;
	color: #8E8E93 !important;
}

.list .item .mark-my {
	position: absolute;
	bottom: 16rpx;
	right: 20rpx;
	font-size: 22rpx;
	z-index: 9;
	color: #86868B;
	opacity: 0.8;
}

.list .item .nv {
	display: none;
}

.list .item .line-title {
	width: 100%;
	display: flex;
	align-items: baseline;
	margin-bottom: 32rpx;
	padding-right: 140rpx;
}

.list .item .line-title .left {
	font-size: 48rpx;
	font-weight: 700;
	position: relative;
	color: #FF3B30;
	letter-spacing: -1rpx;
}

.list .item .line-title .left .price {
	font-size: 28rpx;
	top: 8rpx;
	position: relative;
	color: #FF3B30;
	opacity: 1;
	font-weight: 600;
	margin-right: 4rpx;
}

.list .item .line-title .right {
	font-size: 24rpx;
	color: #86868B;
	margin-left: 16rpx;
	font-weight: 400;
}

.list .item .line2 {
	width: 100%;
	display: flex;
	flex-direction: column;
	background: rgba(0, 0, 0, 0.03);
	border-radius: 20rpx;
	padding: 16rpx 20rpx;
	margin-bottom: 12rpx;
	font-size: 28rpx;
	color: #1D1D1F;
	font-weight: 500;
}

.list .item .line2.margin-top {
	margin-top: 0;
}

.list .item .line2 .t1 {
	width: 100%;
	font-size: 28rpx;
	color: #1D1D1F;
	padding-bottom: 6rpx;
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	line-height: 1.5;
	font-weight: 500;
}

.list .item .line2 .t1 .icon-title {
	display: none;
}

.list .item .line2 .t1 .address {
	flex: 1;
}

.list .item .line2 .t1 .mm {
	font-size: 22rpx;
	color: #fff;
	border-radius: 10rpx;
	margin-right: 12rpx;
	padding: 4rpx 12rpx;
	font-weight: 600;
	min-width: 36rpx;
	text-align: center;
}

.list .item .line2 .t1 .mm.bg-red {
	background: linear-gradient(135deg, #FF6B6B, #FF3B30) !important;
	box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.25);
}

.list .item .line2 .t1 .mm.bg-green {
	background: linear-gradient(135deg, #5DD879, #34C759) !important;
	box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.25);
}

.list .item .line2 .t2 {
	width: 100%;
	font-size: 24rpx;
	color: #86868B;
	padding-left: 0;
	margin-top: 4rpx;
}

.list .item .line-post {
	padding-left: 0;
}

.list .item .line-post .right {
	color: #86868B;
}

.list .oprt {
	width: 100%;
	display: flex;
	justify-content: flex-end;
	padding: 8rpx 0;
	margin-top: -8rpx;
	margin-bottom: 40rpx;
	gap: 12rpx;
}

.list .oprt>view {
	padding: 12rpx 28rpx;
	font-size: 24rpx;
	margin-right: 0;
	border-radius: 999rpx;
	font-weight: 500;
	border: 1rpx solid rgba(255, 255, 255, 0.6);
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.list .oprt>view.bg-pink.light {
	background: rgba(255, 45, 85, 0.12) !important;
	color: #FF2D55 !important;
}

.list .oprt>view.bg-blue.light {
	background: rgba(0, 122, 255, 0.12) !important;
	color: #007AFF !important;
}

.list .oprt>view.bg-orange.light {
	background: rgba(255, 149, 0, 0.12) !important;
	color: #FF9500 !important;
}

.list .oprt>view>text {
	margin-right: 6rpx;
}

.post {
	width: 100%;
	position: fixed;
	left: 0;
	bottom: 0;
	padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
	display: flex;
	justify-content: center;
	align-items: center;
	background: linear-gradient(180deg, rgba(238, 242, 247, 0) 0%, rgba(238, 242, 247, 0.85) 40%);
	pointer-events: none;
}

.post>view,
.post .inner {
	pointer-events: auto;
	z-index: 999;
	font-size: 32rpx;
	font-weight: 600;
	background: linear-gradient(180deg, #3395FF 0%, #007AFF 100%);
	color: #FFFFFF;
	padding: 24rpx 80rpx;
	border-radius: 999rpx;
	box-shadow: 0 12rpx 40rpx rgba(0, 122, 255, 0.4), 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
	border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.btn.round.bg-project {
	border-radius: 999rpx !important;
	padding: 0 28rpx !important;
	height: 64rpx !important;
	line-height: 64rpx !important;
	font-size: 26rpx !important;
	font-weight: 600;
	box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.3);
}

/* 急事代办 - 价格圆形徽章 */
.list .item .line-title .left.circle-price {
	font-size: 28rpx;
	font-weight: 700;
	background: linear-gradient(180deg, #3395FF 0%, #007AFF 100%);
	color: #FFFFFF;
	height: 80rpx;
	width: 80rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.35);
}

.list .item .line-title .left.circle-price .price {
	color: #FFFFFF;
	font-size: 20rpx;
	top: 2rpx;
	right: 2rpx;
}

.list .item .line-title .left.circle-price+.right {
	margin-left: 20rpx;
}

.mark-level span {
	border-top-color: #007AFF !important;
}

.mark-level em {
	color: #FFFFFF !important;
}
