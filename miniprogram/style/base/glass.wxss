/* 苹果毛玻璃 - 通用样式库 */

.glass,
.card-project,
.form-box,
.form-box.card-project,
.main .list .item.card-project,
.down .comm-list.menu.card-project,
.article-box .article.card-project,
.text-pic-list-box .item.card-project,
.info-list-box .item.card-project,
.main-content .content.card-project,
.meet-list-box .item.card-project,
.comm-list-box .item,
.comm-list .item.menu,
.record,
.main .down .data,
.list .item.shadow-project,
.list .item {
	background: rgba(255, 255, 255, 0.72) !important;
	backdrop-filter: blur(40rpx) saturate(180%);
	-webkit-backdrop-filter: blur(40rpx) saturate(180%);
	border: 1rpx solid rgba(255, 255, 255, 0.85);
	box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.glass-strong {
	background: rgba(255, 255, 255, 0.85) !important;
	backdrop-filter: blur(60rpx) saturate(200%);
	-webkit-backdrop-filter: blur(60rpx) saturate(200%);
	border: 1rpx solid rgba(255, 255, 255, 0.9);
	box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.08);
}

.glass-bar {
	background: rgba(255, 255, 255, 0.75) !important;
	backdrop-filter: blur(50rpx) saturate(180%);
	-webkit-backdrop-filter: blur(50rpx) saturate(180%);
	border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.glass-pill {
	border-radius: 999rpx !important;
}

.glass-card {
	border-radius: 32rpx !important;
}
